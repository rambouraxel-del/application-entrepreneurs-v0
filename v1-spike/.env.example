# --- Spike Lot 0 — variables d'environnement ---
# Aucun secret réel ne doit être commité.

# Base PostgreSQL locale du spike.
# Rôle PROPRIÉTAIRE : migrations et création des policies uniquement.
DATABASE_URL_OWNER="postgresql://spike_owner:spike@127.0.0.1:55432/cockpit_spike"
# Rôle APPLICATIF : utilisé par l'application. NON superuser, NON propriétaire
# des tables, sans BYPASSRLS — c'est la condition pour que la RLS s'applique.
DATABASE_URL_APP="postgresql://spike_app:spike@127.0.0.1:55432/cockpit_spike"
# Rôle SYSTÈME : BYPASSRLS. Inscription, webhooks, seed uniquement.
DATABASE_URL_SYSTEM="postgresql://spike_system:spike@127.0.0.1:55432/cockpit_spike"

# --- Non utilisées dans ce spike, documentées pour le Lot 1 ---
# Nécessitent un projet Supabase réel : non testables hors ligne.
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""      # serveur uniquement, jamais exposée au client
# SUPABASE_STORAGE_BUCKET="documents"

# Secret de signature des URL de documents (adaptateur local du spike).
DOCUMENT_URL_SECRET="spike-only-not-a-real-secret"
