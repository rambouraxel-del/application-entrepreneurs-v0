// Cockpit Entrepreneur V1 — schéma étendu au Lot 2.
//
// Lot 1 avait prouvé auth + tenant + DB + UI + CRUD sur un premier objet
// métier (Client) volontairement pauvre. Le Lot 2 enrichit Client au strict
// nécessaire pour le Dashboard et ajoute Task (relance/priorité), toujours
// sans reproduire le modèle complet de docs/v1/data-model.md.
//
// Décision Lot 1 (inchangée) : PAS de table `users` applicative — voir
// docs/v1/lot-1-socle.md §Identité. Membership.userId stocke l'identifiant
// Supabase Auth sans FK Prisma.
//
// Décision Lot 2 (ADR-16, voir docs/v1/lot-2-clients-dashboard.md) : Task est
// un modèle autonome, PAS la table `activities` (RDV + tâches fusionnés)
// prévue par data-model.md. Le Lot 2 exclut explicitement l'agenda/calendrier
// (rendez-vous, créneaux, durée, lieu) : ajouter ces champs maintenant serait
// de la fausse fonctionnalité. Quand l'agenda sera construit, `activities`
// remplacera Task ou Task y sera fusionné — décision reportée, pas perdue.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_OWNER")
}

/// Le tenant. Une organisation = une entreprise cliente.
model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  logoPath    String?      @map("logo_path")
  /// Seuil (en jours) au-delà duquel un client actif/prospect sans contact
  /// récent devient une opportunité "sans contact récent" au Dashboard
  /// (règle d'insight, docs/v1/lot-2-clients-dashboard.md). Réglage minimal
  /// exposé dans Settings — pas de page de configuration étendue au Lot 2.
  clientFollowUpDays Int    @default(30) @map("client_follow_up_days")
  /// Seuils Lot 3 (docs/v1/lot-3-devis.md) — réglages minimaux, pas de page
  /// Settings étendue. Un devis "envoyé" plus vieux que ce seuil devient un
  /// point d'attention ; un devis ouvert au-delà de ce montant devient une
  /// opportunité "forte valeur".
  quoteFollowUpDays  Int    @default(7) @map("quote_follow_up_days")
  quoteHighValueCents Int  @default(500000) @map("quote_high_value_cents") // 5000,00 €

  // --- Identité légale (Lot 4, docs/v1/lot-4-factures-paiements.md §3) -----
  // Nécessaire pour émettre une vraie facture — absente jusqu'ici (Lot 1-3
  // n'en avaient pas besoin, voir ADR-17/18 quote). Tout nullable : une
  // organisation existe avant d'être complète, `validateInvoiceIssuerReadiness()`
  // (modules/invoices/readiness.ts) est le vrai gardien, pas une contrainte
  // NOT NULL prématurée qui bloquerait Lot 1-3 rétroactivement.
  legalName        String?  @map("legal_name")
  /// Nom commercial si différent de la raison sociale — purement d'affichage.
  tradeName        String?  @map("trade_name")
  /// Forme juridique (ex. "EI", "SASU", "SARL"...) — texte libre, pas d'enum :
  /// aucune règle métier n'en dépend, seulement l'affichage sur le document.
  legalForm        String?  @map("legal_form")
  siren            String?  @map("siren") @db.VarChar(9)
  siret            String?  @map("siret") @db.VarChar(14)
  vatNumber        String?  @map("vat_number")
  addressLine1     String?  @map("address_line1")
  addressLine2     String?  @map("address_line2")
  addressPostalCode String? @map("address_postal_code")
  addressCity      String?  @map("address_city")
  /// Code pays ISO 3166-1 alpha-2. Défaut FR : la cible initiale est la France
  /// (docs/positionnement-produit.md) — champ réel, pas figé en dur ailleurs.
  addressCountry   String   @default("FR") @map("address_country")
  professionalEmail String? @map("professional_email")
  professionalPhone String? @map("professional_phone")
  /// Franchise en base de TVA (art. 293 B du CGI) : régime très courant chez
  /// les indépendants/micro-entreprises ciblés (docs/positionnement-produit.md).
  /// Si actif, les lignes de facture sont HT=TTC avec la mention légale
  /// d'exonération plutôt qu'un taux à 0 % nu — voir modules/invoices/calc.ts.
  vatRegime        VatRegime @default(normal) @map("vat_regime")
  /// Option TVA sur les débits (mention obligatoire depuis le 1ᵉʳ septembre 2026
  /// si l'option est exercée — economie.gouv.fr, voir lot-4-factures-paiements.md §16).
  vatOnDebits      Boolean  @default(false) @map("vat_on_debits")
  /// Délai de paiement par défaut, en jours à partir de l'émission — utilisé
  /// pour préremplir `Invoice.dueDate`, jamais imposé.
  defaultPaymentTermDays Int @default(30) @map("default_payment_term_days")
  /// Texte affiché tel quel sur la facture (mention légale de pénalités de
  /// retard, obligatoire — Code de commerce art. L441-10). ⚑ À VALIDER
  /// JURIDIQUEMENT : valeur par défaut usuelle, pas un conseil juridique.
  latePaymentPenaltyText String @default("Taux de pénalité : 3 fois le taux d'intérêt légal.") @map("late_payment_penalty_text")
  /// Idem, escompte — le cas courant (aucun escompte) doit être mentionné explicitement.
  earlyPaymentDiscountText String @default("Pas d'escompte pour paiement anticipé.") @map("early_payment_discount_text")
  /// Indemnité forfaitaire de recouvrement B2B — 40 € par défaut (Code de
  /// commerce art. L441-10 / D441-5, montant réglementaire au moment de la
  /// rédaction). ⚑ À VALIDER JURIDIQUEMENT si le montant réglementaire change.
  latePaymentRecoveryFeeCents Int @default(4000) @map("late_payment_recovery_fee_cents")

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  memberships Membership[]
  clients     Client[]
  tasks       Task[]
  quotes      Quote[]
  invoices    Invoice[]
  payments    Payment[]
  documentCounters DocumentCounter[]

  @@map("organizations")
}

/// Régime de TVA de l'organisation — juste assez pour le moteur de facture
/// (docs/v1/lot-4-factures-paiements.md §20), pas une modélisation complète
/// des régimes fiscaux français.
enum VatRegime {
  normal
  /// Franchise en base (art. 293 B du CGI) : TVA non applicable sur toutes les lignes.
  franchise_en_base
}

/// Lien utilisateur (Supabase Auth) <-> organisation.
/// C'est lui, et lui seul, qui autorise un organizationId — jamais le navigateur.
/// `role` existe dès maintenant pour qu'un futur RBAC n'exige pas de migration
/// de schéma, même si le Lot 1 ne l'exploite pas (un seul rôle possible : owner).
model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  /// Identifiant Supabase Auth (auth.users.id). Pas de FK Prisma : ce schéma
  /// est géré par Supabase, hors du périmètre de nos migrations.
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  role           String       @default("owner")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@map("memberships")
}

enum ClientKind {
  individual
  company
}

/// Statuts CRM minimaux (Lot 2) — repris tels quels de la V0 (seule référence
/// UX disponible), PAS réinventés : ce sont les 5 statuts déjà consommés par
/// le moteur d'insights V0 et compris des utilisateurs actuels. `litige`
/// n'existe pas en V0 et n'est pas ajouté ici par excès de zèle — aucune
/// utilité identifiée pour le Dashboard du Lot 2.
/// ⚑ Hypothèse réversible (aucun test utilisateur V1 conduit) — voir
/// docs/v1/lot-2-clients-dashboard.md §13.
enum ClientStatus {
  prospect
  active     /// "Client actif"
  to_follow_up /// "À relancer"
  inactive
  loyal      /// "Fidèle"
}

/// Objet métier Client, étendu au strict nécessaire au Lot 2 (Dashboard +
/// relances). Toujours pas d'historique exhaustif, pas de documents liés,
/// pas de champs personnalisés — ce n'est pas un CRM.
model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  kind           ClientKind   @default(individual)
  name           String
  companyName    String?      @map("company_name")
  email          String?
  phone          String?
  status         ClientStatus @default(prospect)
  /// Notes libres courtes — pas d'historique typé/horodaté (hors périmètre).
  notes          String?
  /// Dernier contact connu. Alimente la règle "sans contact récent"
  /// (docs/v1/lot-2-clients-dashboard.md §10). Renseigné manuellement au
  /// Lot 2 (pas encore déduit d'un devis/RDV, qui n'existent pas).
  lastContactAt  DateTime?    @map("last_contact_at")
  /// Archivage = seule forme de "suppression" (décision Lot 1, inchangée).
  /// Séparé de `status` : un client peut être "fidèle" ET archivé (ancien
  /// client fidèle qu'on ne veut plus voir dans les listes actives).
  archivedAt     DateTime?    @map("archived_at")

  // --- Données de facturation (Lot 4, §6) -----------------------------------
  // Structurées séparément de l'identité commerciale (name/companyName
  // ci-dessus, inchangés) : la donnée commerciale reste celle affichée dans
  // les listes/Dashboard, la donnée de facturation n'est utilisée qu'à
  // l'émission (snapshot). Tout nullable — `validateInvoiceIssuerReadiness`
  // (côté Organization) a son pendant côté Client dans
  // `modules/invoices/readiness.ts::assertClientBillingReady`.
  /// Raison sociale exacte pour la facture, si différente de `companyName`
  /// (souvent identique — champ distinct pour ne jamais réutiliser un champ
  /// commercial comme source légale par coïncidence).
  billingLegalName String?  @map("billing_legal_name")
  billingAddressLine1     String? @map("billing_address_line1")
  billingAddressLine2     String? @map("billing_address_line2")
  billingAddressPostalCode String? @map("billing_address_postal_code")
  billingAddressCity     String?  @map("billing_address_city")
  billingAddressCountry  String?  @map("billing_address_country")
  billingEmail    String?  @map("billing_email")
  siren           String?  @map("siren") @db.VarChar(9)
  vatNumber       String?  @map("vat_number")
  /// Adresse de livraison — UNIQUEMENT si différente de l'adresse de
  /// facturation (mention devenue obligatoire au 1ᵉʳ septembre 2026 dans ce
  /// cas précis — economie.gouv.fr). Nulle = "identique à la facturation".
  deliveryAddressLine1     String? @map("delivery_address_line1")
  deliveryAddressLine2     String? @map("delivery_address_line2")
  deliveryAddressPostalCode String? @map("delivery_address_postal_code")
  deliveryAddressCity     String?  @map("delivery_address_city")
  deliveryAddressCountry  String?  @map("delivery_address_country")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          Task[]
  quotes         Quote[]
  invoices       Invoice[]

  @@index([organizationId, status])
  @@index([organizationId, lastContactAt])
  @@map("clients")
}

enum TaskPriority {
  low
  normal
  high
}

/// Action/relance minimale — PAS un gestionnaire de projet : pas de
/// sous-tâches, pas de projets, pas de récurrence, pas de collaboration.
/// Objectif unique : que "Relancer Martin Dupont aujourd'hui" existe quelque
/// part et apparaisse au Dashboard (docs/v1/lot-2-clients-dashboard.md §3).
model Task {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  /// Nullable : une tâche n'a pas toujours de client (ex. tâche administrative).
  /// Vérifié côté service que le client, s'il est fourni, appartient à la
  /// même organisation — jamais une simple FK db sans contrôle applicatif
  /// explicite, voir src/modules/tasks/service.ts.
  clientId       String?       @map("client_id") @db.Uuid
  title          String
  dueDate        DateTime?     @map("due_date") @db.Date
  completedAt    DateTime?     @map("completed_at")
  priority       TaskPriority  @default(normal)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId, dueDate])
  @@index([organizationId, completedAt])
  @@map("tasks")
}

// =============================================================================
// Lot 3 — Devis (docs/v1/lot-3-devis.md)
// =============================================================================
//
// Convention monétaire — INVARIANT du Lot 0, reprise sans modification
// (docs/v1/architecture.md §8) : tout montant est un entier de CENTIMES, toute
// quantité un entier de MILLIÈMES, tout taux un entier de POINTS DE BASE.
// Aucune colonne monétaire en float. Le calcul vit dans
// src/modules/quotes/calc.ts (arithmétique BigInt, portée telle quelle du
// spike Lot 0 — v1-spike/src/money/money.ts) ; les totaux stockés ici sont la
// SOMME DES LIGNES déjà arrondies, jamais recalculés par une formule document.
//
// Déviation assumée par rapport à data-model.md (ADR-17, voir lot-3-devis.md) :
// `quantity` y était prévu en `Decimal(12,3)`. Implémenté ici en `Int`
// (`quantityMilli`) pour rester dans la même arithmétique entière que le
// calculateur validé au Lot 0 (BigInt), sans introduire le type Prisma
// `Decimal` (sérialisation, comparaisons, tests plus fragiles).

/// Compteur transactionnel par (organisation, type de document, année).
/// Mécanisme validé au Lot 0 (lot-0-validation.md §6) : allocation par
/// `INSERT ... ON CONFLICT DO UPDATE ... RETURNING` dans la transaction
/// d'émission — jamais MAX+1/COUNT+1. `docType` est une chaîne ("quote"
/// aujourd'hui, "invoice" au Lot 4) plutôt qu'un enum : la table sert déjà
/// aux deux, pas de migration de schéma à prévoir pour le Lot 4.
model DocumentCounter {
  organizationId String       @map("organization_id") @db.Uuid
  docType        String       @map("doc_type")
  year           Int
  lastValue      Int          @default(0) @map("last_value")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, docType, year])
  @@map("document_counters")
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  expired
}

/// Devis. `issuedAt NULL` = brouillon, librement modifiable. `issuedAt` posé =
/// émis : le trigger `quotes_protect_issued` (prisma/rls.sql) interdit alors
/// toute modification hors transition de statut autorisée et régénération du
/// PDF — appliqué en base, pas seulement côté service (docs/v1/lot-3-devis.md
/// §Immutabilité).
model Quote {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  clientId       String       @map("client_id") @db.Uuid
  /// Nul tant que brouillon ; alloué à l'émission (DocumentCounter).
  number         String?
  status         QuoteStatus  @default(draft)
  issuedAt       DateTime?    @map("issued_at")
  validUntil     DateTime?    @map("valid_until") @db.Date
  notes          String?
  /// Identité du client au moment de l'émission — figée, jamais recalculée
  /// depuis `clients` après coup (modifier la fiche Client ne doit rien
  /// changer à un devis déjà émis).
  clientSnapshot Json?        @map("client_snapshot")
  /// Identité de l'émetteur au moment de l'émission. ⚑ À VALIDER JURIDIQUEMENT :
  /// `Organization` ne porte pas encore SIRET/adresse légale (hors périmètre
  /// Lot 1-3) — le snapshot ne contient que ce qui existe réellement
  /// aujourd'hui (nom). Les mentions légales complètes viendront avec
  /// l'enrichissement d'Organization, avant le Lot 4 (factures).
  organizationSnapshot Json?  @map("organization_snapshot")
  totalHtCents   Int          @default(0) @map("total_ht_cents")
  totalVatCents  Int          @default(0) @map("total_vat_cents")
  totalTtcCents  Int          @default(0) @map("total_ttc_cents")
  /// Récapitulatif par taux de TVA — présentation obligatoire sur un document
  /// commercial français. `[{ vatRateBp, baseHtCents, vatCents }]`.
  vatBreakdown   Json         @default("[]") @map("vat_breakdown")
  pdfPath        String?      @map("pdf_path")
  pdfSha256      String?      @map("pdf_sha256")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lines          QuoteLine[]
  /// Facture issue de ce devis, s'il y en a une (Lot 4) — jamais plus d'une, voir `Invoice.sourceQuoteId @unique`.
  invoice        Invoice?

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, issuedAt])
  @@map("quotes")
}

/// Ligne de devis — donnée PROPRE au document (description, prix, TVA
/// copiés), jamais une référence vivante à un catalogue (qui n'existe pas
/// encore, hors P0 — docs/mvp-commercial.md). `organizationId` dénormalisé
/// pour porter la même policy RLS simple que les autres tables métier ;
/// vérifié explicitement côté service que `quoteId` appartient bien à
/// l'organisation courante avant toute écriture (jamais seulement la RLS ou
/// la contrainte FK — même principe que `assertClientBelongsToOrg`).
model QuoteLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  quoteId        String   @map("quote_id") @db.Uuid
  position       Int
  description    String
  /// Unité d'affichage libre (ex. "jour", "h", "unité") — jamais utilisée dans
  /// le calcul, purement informative.
  unit           String?
  /// Quantité en millièmes entiers (1,5 → 1500) — voir note de convention en
  /// tête de section.
  quantityMilli  Int      @map("quantity_milli")
  unitPriceCents Int      @map("unit_price_cents")
  vatRateBp      Int      @map("vat_rate_bp")
  discountBp     Int      @default(0) @map("discount_bp")
  /// Montants calculés et STOCKÉS (src/modules/quotes/calc.ts), jamais
  /// recalculés par une formule au niveau document.
  grossHtCents   Int      @map("gross_ht_cents")
  discountCents  Int      @map("discount_cents")
  netHtCents     Int      @map("net_ht_cents")
  vatCents       Int      @map("vat_cents")
  totalTtcCents  Int      @map("total_ttc_cents")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, position])
  @@map("quote_lines")
}

// =============================================================================
// Lot 4 — Factures et paiements (docs/v1/lot-4-factures-paiements.md)
// =============================================================================
//
// Réutilise SANS MODIFICATION le calculateur financier (src/modules/quotes/calc.ts,
// renommé conceptuellement "modules/billing/calc.ts" en interne au Lot 4 —
// voir §5 du compte rendu) et le mécanisme de numérotation (lib/numbering/allocate.ts,
// docType='invoice'). Même trigger d'immutabilité que Quote, adapté.
//
// Décision Lot 4 (ADR-19, voir lot-4-factures-paiements.md) : `Invoice` ne
// stocke PAS d'agrégat `amount_paid_cents` (prévu par data-model.md) — le
// montant payé/restant dû est calculé à la lecture (SUM des Payment actifs),
// jamais dupliqué. Volume MVP trop faible pour justifier un agrégat
// transactionnel (règle "pas d'optimisation prématurée", consigne Lot 4 §27)
// et ça élimine une classe entière de bugs de désynchronisation.
//
// Décision Lot 4 (cycle documentaire vs état de paiement, §28) : `Invoice.status`
// ne connaît que `draft | issued` — jamais `overdue`/`partial`/`paid`, qui sont
// un axe ORTHOGONAL dérivé à la volée (modules/invoices/paymentStatus.ts),
// jamais stocké. Mêmes principes que le statut de devis/facture "affiché"
// déjà spécifié par architecture.md §9.1.

enum InvoiceStatus {
  draft
  issued
}

/// Catégorie de l'opération — mention devenue obligatoire au 1ᵉʳ septembre 2026
/// (economie.gouv.fr : "catégorie de l'opération (vente, prestation de
/// services ou les deux)").
enum OperationCategory {
  goods
  services
  mixed
}

/// Facture. Même principe d'immutabilité que Quote (trigger DB,
/// prisma/rls.sql) : `issuedAt` posé = figé, hors transition de statut de
/// paiement (qui n'existe pas ici, voir note en tête de section — le
/// paiement vit dans `Payment`, jamais une colonne de `Invoice`) et
/// régénération du PDF.
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  clientId       String        @map("client_id") @db.Uuid
  /// Origine — une facture peut aussi être créée sans devis (hors parcours
  /// principal du Lot 4, mais le modèle ne l'interdit pas inutilement).
  /// `UNIQUE` : un devis ne produit jamais deux factures (§9 du compte rendu).
  sourceQuoteId  String?       @unique @map("source_quote_id") @db.Uuid
  /// Nul tant que brouillon ; alloué à l'émission (DocumentCounter, docType='invoice').
  number         String?
  status         InvoiceStatus @default(draft)
  issuedAt       DateTime?     @map("issued_at")
  /// Date de vente/livraison/réalisation de la prestation — distincte de
  /// `issuedAt` (mention obligatoire, souvent identique mais pas toujours :
  /// une prestation réalisée en fin de mois, facturée début du mois suivant).
  supplyDate     DateTime      @map("supply_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  operationCategory OperationCategory @default(services) @map("operation_category")
  purchaseOrderNumber String? @map("purchase_order_number")
  /// Snapshot de `Organization.vatOnDebits` au moment de l'émission — mention
  /// figée comme le reste, jamais recalculée depuis l'Organization courante.
  vatOnDebits    Boolean       @default(false) @map("vat_on_debits")
  notes          String?
  /// Identité légale complète de l'émetteur au moment de l'émission — voir
  /// modules/invoices/snapshot.ts pour la structure exacte.
  issuerSnapshot Json?         @map("issuer_snapshot")
  /// Identité/adresses de facturation ET livraison du client, figées.
  clientSnapshot Json?         @map("client_snapshot")
  /// Conditions de paiement réellement applicables (délai, pénalités,
  /// escompte, indemnité forfaitaire) — copiées depuis Organization à
  /// l'émission, jamais recalculées après coup.
  paymentTermsSnapshot Json?   @map("payment_terms_snapshot")
  totalHtCents   Int           @default(0) @map("total_ht_cents")
  totalVatCents  Int           @default(0) @map("total_vat_cents")
  totalTtcCents  Int           @default(0) @map("total_ttc_cents")
  vatBreakdown   Json          @default("[]") @map("vat_breakdown")
  pdfPath        String?       @map("pdf_path")
  pdfSha256      String?       @map("pdf_sha256")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sourceQuote    Quote?        @relation(fields: [sourceQuoteId], references: [id], onDelete: SetNull)
  lines          InvoiceLine[]
  payments       Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, issuedAt])
  @@index([organizationId, dueDate])
  @@map("invoices")
}

/// Ligne de facture — donnée propre au document, copiée depuis la QuoteLine
/// d'origine s'il y en a une (jamais partagée/référencée : voir §10 du
/// compte rendu, "Ne réutilise pas les QuoteLine comme InvoiceLine").
model InvoiceLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  position       Int
  description    String
  unit           String?
  quantityMilli  Int      @map("quantity_milli")
  unitPriceCents Int      @map("unit_price_cents")
  vatRateBp      Int      @map("vat_rate_bp")
  discountBp     Int      @default(0) @map("discount_bp")
  /// Motif d'exonération de TVA si `vatRateBp = 0` pour une raison légale
  /// (franchise en base, export...) plutôt qu'un taux à 0 % nu — mention
  /// obligatoire quand applicable (§20 du compte rendu). Nul si la ligne est
  /// simplement taxée à 0 % sans exonération particulière (rare mais possible).
  vatExemptionCode String? @map("vat_exemption_code")
  vatLegalNotice String?  @map("vat_legal_notice")
  grossHtCents   Int      @map("gross_ht_cents")
  discountCents  Int      @map("discount_cents")
  netHtCents     Int      @map("net_ht_cents")
  vatCents       Int      @map("vat_cents")
  totalTtcCents  Int      @map("total_ttc_cents")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, position])
  @@map("invoice_lines")
}

enum PaymentMethod {
  bank_transfer
  card
  cash
  check
  direct_debit
  other
}

/// Encaissement — fait traçable, jamais mutable en place (§33 du compte
/// rendu). Une facture peut recevoir plusieurs paiements (partiels).
/// PAS de PaymentLine, pas de rapprochement bancaire, pas de Stripe (hors
/// périmètre Lot 4).
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  invoiceId      String        @map("invoice_id") @db.Uuid
  amountCents    Int           @map("amount_cents")
  paidAt         DateTime      @map("paid_at") @db.Date
  method         PaymentMethod @default(bank_transfer)
  reference      String?
  note           String?
  /// Empêche un double clic/retry de créer deux paiements identiques —
  /// unique par organisation quand fourni (NULL exclu de la contrainte,
  /// plusieurs paiements sans clé restent possibles).
  idempotencyKey String?       @map("idempotency_key")
  /// Annulation tracée, jamais de suppression physique (§33). Un paiement
  /// annulé reste en base mais sort du calcul de `amountPaidCents`.
  cancelledAt    DateTime?     @map("cancelled_at")
  cancellationReason String?  @map("cancellation_reason")
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, invoiceId])
  @@index([organizationId, paidAt])
  @@map("payments")
}
