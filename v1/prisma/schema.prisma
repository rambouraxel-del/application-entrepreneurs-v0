// Cockpit Entrepreneur V1 — schéma étendu au Lot 2.
//
// Lot 1 avait prouvé auth + tenant + DB + UI + CRUD sur un premier objet
// métier (Client) volontairement pauvre. Le Lot 2 enrichit Client au strict
// nécessaire pour le Dashboard et ajoute Task (relance/priorité), toujours
// sans reproduire le modèle complet de docs/v1/data-model.md.
//
// Décision Lot 1 (inchangée) : PAS de table `users` applicative — voir
// docs/v1/lot-1-socle.md §Identité. Membership.userId stocke l'identifiant
// Supabase Auth sans FK Prisma.
//
// Décision Lot 2 (ADR-16, voir docs/v1/lot-2-clients-dashboard.md) : Task est
// un modèle autonome, PAS la table `activities` (RDV + tâches fusionnés)
// prévue par data-model.md. Le Lot 2 exclut explicitement l'agenda/calendrier
// (rendez-vous, créneaux, durée, lieu) : ajouter ces champs maintenant serait
// de la fausse fonctionnalité. Quand l'agenda sera construit, `activities`
// remplacera Task ou Task y sera fusionné — décision reportée, pas perdue.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_OWNER")
}

/// Le tenant. Une organisation = une entreprise cliente.
model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  logoPath    String?      @map("logo_path")
  /// Seuil (en jours) au-delà duquel un client actif/prospect sans contact
  /// récent devient une opportunité "sans contact récent" au Dashboard
  /// (règle d'insight, docs/v1/lot-2-clients-dashboard.md). Réglage minimal
  /// exposé dans Settings — pas de page de configuration étendue au Lot 2.
  clientFollowUpDays Int    @default(30) @map("client_follow_up_days")
  /// Seuils Lot 3 (docs/v1/lot-3-devis.md) — réglages minimaux, pas de page
  /// Settings étendue. Un devis "envoyé" plus vieux que ce seuil devient un
  /// point d'attention ; un devis ouvert au-delà de ce montant devient une
  /// opportunité "forte valeur".
  quoteFollowUpDays  Int    @default(7) @map("quote_follow_up_days")
  quoteHighValueCents Int  @default(500000) @map("quote_high_value_cents") // 5000,00 €
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  memberships Membership[]
  clients     Client[]
  tasks       Task[]
  quotes      Quote[]
  documentCounters DocumentCounter[]

  @@map("organizations")
}

/// Lien utilisateur (Supabase Auth) <-> organisation.
/// C'est lui, et lui seul, qui autorise un organizationId — jamais le navigateur.
/// `role` existe dès maintenant pour qu'un futur RBAC n'exige pas de migration
/// de schéma, même si le Lot 1 ne l'exploite pas (un seul rôle possible : owner).
model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  /// Identifiant Supabase Auth (auth.users.id). Pas de FK Prisma : ce schéma
  /// est géré par Supabase, hors du périmètre de nos migrations.
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  role           String       @default("owner")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@map("memberships")
}

enum ClientKind {
  individual
  company
}

/// Statuts CRM minimaux (Lot 2) — repris tels quels de la V0 (seule référence
/// UX disponible), PAS réinventés : ce sont les 5 statuts déjà consommés par
/// le moteur d'insights V0 et compris des utilisateurs actuels. `litige`
/// n'existe pas en V0 et n'est pas ajouté ici par excès de zèle — aucune
/// utilité identifiée pour le Dashboard du Lot 2.
/// ⚑ Hypothèse réversible (aucun test utilisateur V1 conduit) — voir
/// docs/v1/lot-2-clients-dashboard.md §13.
enum ClientStatus {
  prospect
  active     /// "Client actif"
  to_follow_up /// "À relancer"
  inactive
  loyal      /// "Fidèle"
}

/// Objet métier Client, étendu au strict nécessaire au Lot 2 (Dashboard +
/// relances). Toujours pas d'historique exhaustif, pas de documents liés,
/// pas de champs personnalisés — ce n'est pas un CRM.
model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  kind           ClientKind   @default(individual)
  name           String
  companyName    String?      @map("company_name")
  email          String?
  phone          String?
  status         ClientStatus @default(prospect)
  /// Notes libres courtes — pas d'historique typé/horodaté (hors périmètre).
  notes          String?
  /// Dernier contact connu. Alimente la règle "sans contact récent"
  /// (docs/v1/lot-2-clients-dashboard.md §10). Renseigné manuellement au
  /// Lot 2 (pas encore déduit d'un devis/RDV, qui n'existent pas).
  lastContactAt  DateTime?    @map("last_contact_at")
  /// Archivage = seule forme de "suppression" (décision Lot 1, inchangée).
  /// Séparé de `status` : un client peut être "fidèle" ET archivé (ancien
  /// client fidèle qu'on ne veut plus voir dans les listes actives).
  archivedAt     DateTime?    @map("archived_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          Task[]
  quotes         Quote[]

  @@index([organizationId, status])
  @@index([organizationId, lastContactAt])
  @@map("clients")
}

enum TaskPriority {
  low
  normal
  high
}

/// Action/relance minimale — PAS un gestionnaire de projet : pas de
/// sous-tâches, pas de projets, pas de récurrence, pas de collaboration.
/// Objectif unique : que "Relancer Martin Dupont aujourd'hui" existe quelque
/// part et apparaisse au Dashboard (docs/v1/lot-2-clients-dashboard.md §3).
model Task {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  /// Nullable : une tâche n'a pas toujours de client (ex. tâche administrative).
  /// Vérifié côté service que le client, s'il est fourni, appartient à la
  /// même organisation — jamais une simple FK db sans contrôle applicatif
  /// explicite, voir src/modules/tasks/service.ts.
  clientId       String?       @map("client_id") @db.Uuid
  title          String
  dueDate        DateTime?     @map("due_date") @db.Date
  completedAt    DateTime?     @map("completed_at")
  priority       TaskPriority  @default(normal)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId, dueDate])
  @@index([organizationId, completedAt])
  @@map("tasks")
}

// =============================================================================
// Lot 3 — Devis (docs/v1/lot-3-devis.md)
// =============================================================================
//
// Convention monétaire — INVARIANT du Lot 0, reprise sans modification
// (docs/v1/architecture.md §8) : tout montant est un entier de CENTIMES, toute
// quantité un entier de MILLIÈMES, tout taux un entier de POINTS DE BASE.
// Aucune colonne monétaire en float. Le calcul vit dans
// src/modules/quotes/calc.ts (arithmétique BigInt, portée telle quelle du
// spike Lot 0 — v1-spike/src/money/money.ts) ; les totaux stockés ici sont la
// SOMME DES LIGNES déjà arrondies, jamais recalculés par une formule document.
//
// Déviation assumée par rapport à data-model.md (ADR-17, voir lot-3-devis.md) :
// `quantity` y était prévu en `Decimal(12,3)`. Implémenté ici en `Int`
// (`quantityMilli`) pour rester dans la même arithmétique entière que le
// calculateur validé au Lot 0 (BigInt), sans introduire le type Prisma
// `Decimal` (sérialisation, comparaisons, tests plus fragiles).

/// Compteur transactionnel par (organisation, type de document, année).
/// Mécanisme validé au Lot 0 (lot-0-validation.md §6) : allocation par
/// `INSERT ... ON CONFLICT DO UPDATE ... RETURNING` dans la transaction
/// d'émission — jamais MAX+1/COUNT+1. `docType` est une chaîne ("quote"
/// aujourd'hui, "invoice" au Lot 4) plutôt qu'un enum : la table sert déjà
/// aux deux, pas de migration de schéma à prévoir pour le Lot 4.
model DocumentCounter {
  organizationId String       @map("organization_id") @db.Uuid
  docType        String       @map("doc_type")
  year           Int
  lastValue      Int          @default(0) @map("last_value")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, docType, year])
  @@map("document_counters")
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  expired
}

/// Devis. `issuedAt NULL` = brouillon, librement modifiable. `issuedAt` posé =
/// émis : le trigger `quotes_protect_issued` (prisma/rls.sql) interdit alors
/// toute modification hors transition de statut autorisée et régénération du
/// PDF — appliqué en base, pas seulement côté service (docs/v1/lot-3-devis.md
/// §Immutabilité).
model Quote {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  clientId       String       @map("client_id") @db.Uuid
  /// Nul tant que brouillon ; alloué à l'émission (DocumentCounter).
  number         String?
  status         QuoteStatus  @default(draft)
  issuedAt       DateTime?    @map("issued_at")
  validUntil     DateTime?    @map("valid_until") @db.Date
  notes          String?
  /// Identité du client au moment de l'émission — figée, jamais recalculée
  /// depuis `clients` après coup (modifier la fiche Client ne doit rien
  /// changer à un devis déjà émis).
  clientSnapshot Json?        @map("client_snapshot")
  /// Identité de l'émetteur au moment de l'émission. ⚑ À VALIDER JURIDIQUEMENT :
  /// `Organization` ne porte pas encore SIRET/adresse légale (hors périmètre
  /// Lot 1-3) — le snapshot ne contient que ce qui existe réellement
  /// aujourd'hui (nom). Les mentions légales complètes viendront avec
  /// l'enrichissement d'Organization, avant le Lot 4 (factures).
  organizationSnapshot Json?  @map("organization_snapshot")
  totalHtCents   Int          @default(0) @map("total_ht_cents")
  totalVatCents  Int          @default(0) @map("total_vat_cents")
  totalTtcCents  Int          @default(0) @map("total_ttc_cents")
  /// Récapitulatif par taux de TVA — présentation obligatoire sur un document
  /// commercial français. `[{ vatRateBp, baseHtCents, vatCents }]`.
  vatBreakdown   Json         @default("[]") @map("vat_breakdown")
  pdfPath        String?      @map("pdf_path")
  pdfSha256      String?      @map("pdf_sha256")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lines          QuoteLine[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, issuedAt])
  @@map("quotes")
}

/// Ligne de devis — donnée PROPRE au document (description, prix, TVA
/// copiés), jamais une référence vivante à un catalogue (qui n'existe pas
/// encore, hors P0 — docs/mvp-commercial.md). `organizationId` dénormalisé
/// pour porter la même policy RLS simple que les autres tables métier ;
/// vérifié explicitement côté service que `quoteId` appartient bien à
/// l'organisation courante avant toute écriture (jamais seulement la RLS ou
/// la contrainte FK — même principe que `assertClientBelongsToOrg`).
model QuoteLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  quoteId        String   @map("quote_id") @db.Uuid
  position       Int
  description    String
  /// Unité d'affichage libre (ex. "jour", "h", "unité") — jamais utilisée dans
  /// le calcul, purement informative.
  unit           String?
  /// Quantité en millièmes entiers (1,5 → 1500) — voir note de convention en
  /// tête de section.
  quantityMilli  Int      @map("quantity_milli")
  unitPriceCents Int      @map("unit_price_cents")
  vatRateBp      Int      @map("vat_rate_bp")
  discountBp     Int      @default(0) @map("discount_bp")
  /// Montants calculés et STOCKÉS (src/modules/quotes/calc.ts), jamais
  /// recalculés par une formule au niveau document.
  grossHtCents   Int      @map("gross_ht_cents")
  discountCents  Int      @map("discount_cents")
  netHtCents     Int      @map("net_ht_cents")
  vatCents       Int      @map("vat_cents")
  totalTtcCents  Int      @map("total_ttc_cents")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, position])
  @@map("quote_lines")
}
