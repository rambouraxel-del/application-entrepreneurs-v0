# Cockpit Entrepreneur V1 — variables d'environnement.
# Copier en .env pour le développement local : cp .env.example .env
# Aucun secret réel n'est commité dans ce fichier.

# --- PostgreSQL local ---------------------------------------------------
# En développement local, ces trois URL pointent vers le même serveur
# PostgreSQL mais des RÔLES différents (docs/v1/lot-0-validation.md §8.3).
# En production (Supabase), le rôle "propriétaire" correspond au rôle
# postgres/service_role, l'"applicatif" à un rôle dédié NOBYPASSRLS, et le
# "système" reste confiné aux migrations/inscription.

# Rôle PROPRIÉTAIRE : migrations Prisma, policies RLS. Jamais utilisé par le
# code applicatif à l'exécution.
DATABASE_URL_OWNER="postgresql://cockpit_owner:cockpit@127.0.0.1:5432/cockpit_v1"

# Rôle APPLICATIF (NOBYPASSRLS) : utilisé par src/lib/db/client.ts (`db`).
# C'est lui qui est soumis à la RLS.
DATABASE_URL_APP="postgresql://cockpit_app:cockpit@127.0.0.1:5432/cockpit_v1"

# Rôle SYSTÈME (BYPASSRLS) : confiné à src/lib/db/system.ts (inscription,
# seed). Ne jamais l'utiliser ailleurs.
DATABASE_URL_SYSTEM="postgresql://cockpit_system:cockpit@127.0.0.1:5432/cockpit_v1"

# --- Supabase (authentification + stockage) -----------------------------
# ⚠️ NON RENSEIGNÉES DANS CET ENVIRONNEMENT DE DÉVELOPPEMENT DU LOT 1 : aucun
# projet Supabase cloud n'était accessible. Le code d'intégration est réel et
# complet (src/lib/supabase/), mais son exécution contre un vrai projet reste
# à valider — voir docs/v1/lot-1-socle.md "VALIDATION CLOUD REQUISE".
#
# URL publique et clé anonyme du projet Supabase (Project Settings > API).
# Préfixe NEXT_PUBLIC_ volontaire : ces deux valeurs sont conçues par Supabase
# pour atteindre le navigateur (protégées par les policies RLS/Auth, pas par
# leur confidentialité) et sont aussi utilisées côté serveur.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Clé de service : SERVEUR UNIQUEMENT, ne doit jamais atteindre le navigateur
# ni un log. Contourne les policies Supabase (RLS Storage, Auth admin) —
# utilisée uniquement dans src/lib/db/system.ts et équivalents Storage.
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket de stockage pour les logos d'organisation (Lot 1). Les documents
# (PDF factures/devis) viendront dans un lot ultérieur avec leur propre bucket.
SUPABASE_STORAGE_BUCKET="org-logos"

# --- Application ----------------------------------------------------------
# URL de base de l'application, utilisée pour les redirections d'auth
# (confirmation d'e-mail, réinitialisation de mot de passe).
# local :      http://localhost:3000
# preview :    URL de préversion Vercel (générée automatiquement)
# production : https://app.cockpit-entrepreneur.example (à adapter)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
